+// TV remotes and gamepads, following the Android TV bindings (backends/platform/android/android.cpp).
+// A backend binding replaces all default inputs of that action, so the existing ones are listed again.
+Common::KeymapperDefaultBindings *OSystem_Emscripten::getKeymapperDefaultBindings() {
+	Common::KeymapperDefaultBindings *bindings = new Common::KeymapperDefaultBindings();
+
+	// The remote Back key reaches SDL as AC_BACK: skip in games, close in dialogs.
+	bindings->setDefaultBinding(Common::kStandardActionsKeymapName, Common::kStandardActionSkip, "ESCAPE");
+	bindings->addDefaultBinding(Common::kStandardActionsKeymapName, Common::kStandardActionSkip, "JOY_Y");
+	bindings->addDefaultBinding(Common::kStandardActionsKeymapName, Common::kStandardActionSkip, "AC_BACK");
+	bindings->setDefaultBinding(Common::kGuiKeymapName, "CLOS", "ESCAPE");
+	bindings->addDefaultBinding(Common::kGuiKeymapName, "CLOS", "JOY_Y");
+	bindings->addDefaultBinding(Common::kGuiKeymapName, "CLOS", "AC_BACK");
+
+	// The gamepad D-pad drives the cursor like the left stick, so pads without a stick work in point-and-click games.
+	bindings->setDefaultBinding(Common::kGlobalKeymapName, "VMOUSEUP", "JOY_LEFT_STICK_Y-");
+	bindings->addDefaultBinding(Common::kGlobalKeymapName, "VMOUSEUP", "JOY_UP");
+	bindings->setDefaultBinding(Common::kGlobalKeymapName, "VMOUSEDOWN", "JOY_LEFT_STICK_Y+");
+	bindings->addDefaultBinding(Common::kGlobalKeymapName, "VMOUSEDOWN", "JOY_DOWN");
+	bindings->setDefaultBinding(Common::kGlobalKeymapName, "VMOUSELEFT", "JOY_LEFT_STICK_X-");
+	bindings->addDefaultBinding(Common::kGlobalKeymapName, "VMOUSELEFT", "JOY_LEFT");
+	bindings->setDefaultBinding(Common::kGlobalKeymapName, "VMOUSERIGHT", "JOY_LEFT_STICK_X+");
+	bindings->addDefaultBinding(Common::kGlobalKeymapName, "VMOUSERIGHT", "JOY_RIGHT");
+
+	// Free the D-pad from the direction actions; keyboard arrows still reach the GUI and games as plain keys.
+	const char *const keymapsWithDirections[] = { Common::kGuiKeymapName, "engine-default" };
+	const char *const directions[] = { Common::kStandardActionMoveUp, Common::kStandardActionMoveDown,
+	                                   Common::kStandardActionMoveLeft, Common::kStandardActionMoveRight };
+	for (const char *keymap : keymapsWithDirections) {
+		for (const char *direction : directions) {
+			bindings->setDefaultBinding(keymap, direction, "");
+		}
+	}
+
+	return bindings;
+}
