+// Not translated: the TV app around ScummVM is English only.
+static const char *const tvRemoteHelp =
+"## TV remote\n"
+"\n"
+"| Button | Action\n"
+"| -------|-------\n"
+"| Arrows | Move the cursor\n"
+"| OK | Click (hold to drag)\n"
+"| Play/Pause | Right click\n"
+"| Back | Skip a scene, close a menu\n"
+"| Back held | ScummVM menu (save, load, quit)\n"
+"| CH+ / CH- | Skip a line of dialogue / virtual keyboard\n"
+"| Play/Pause twice | TV settings\n"
+"\n"
+"## Adding your own games\n"
+"\n"
+"Click **TV settings...** next to **Add Game...**, or press **Play/Pause** twice. It downloads the free games, copies games "
+"from a PC, a phone or a USB drive, and sets the cursor speed. Add a copied game with **Add Game...**, "
+"then `/data/tv` and the game's folder.\n"
+"\n"
+"## About this port\n"
+"\n"
+"This is an unofficial build of ScummVM for Samsung Tizen TVs, not made by the ScummVM team. Report problems at "
+"[github.com/thalesv6/scummvm-tizen](https://github.com/thalesv6/scummvm-tizen/issues), with a photo of "
+"**TV settings**, **TV info**.\n";
+
+const char * const *OSystem_Emscripten::buildHelpDialogData() {
+	// Built once: the Help dialog keeps the pointer.
+	static Common::Array<const char *> tabs;
+	if (tabs.empty()) {
+		tabs.push_back("TV remote");
+		tabs.push_back("");
+		tabs.push_back(tvRemoteHelp);
+		for (const char * const *tab = OSystem_SDL::buildHelpDialogData(); *tab; tab++)
+			tabs.push_back(*tab);
+		tabs.push_back(nullptr);
+	}
+	return tabs.data();
+}
